generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  role         UserRole      @default(OPERATOR)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activityLogs ActivityLog[]
  invoices     Invoice[]
  services     Service[]
}

model Customer {
  id            String            @id @default(cuid())
  name          String
  mobile        String            @unique
  email         String?
  address       String?
  aadhaarNumber String?
  panNumber     String?
  photoUrl      String?
  signatureUrl  String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  loyaltyPoints Int               @default(0)
  anniversary   DateTime?
  dob           DateTime?
  groupId       String?
  rating        Int?
  referredById  String?
  tags          String[]
  walletBalance Float             @default(0)
  followUpDate  DateTime?
  referredBy    Customer?         @relation("CustomerReferral", fields: [referredById], references: [id])
  referrals     Customer[]        @relation("CustomerReferral")
  payments      CustomerPayment[]
  documents     Document[]
  invoices      Invoice[]
  services      Service[]

  @@index([name])
  @@index([aadhaarNumber])
  @@index([panNumber])
  @@index([createdAt])
  @@index([referredById])
}

model Service {
  id             String            @id @default(cuid())
  serviceType    String
  status         ServiceStatus     @default(PENDING)
  customerId     String
  assignedToId   String?
  fees           Float             @default(0)
  paymentStatus  PaymentStatus     @default(UNPAID)
  paymentMode    PaymentMode       @default(PENDING)
  notes          String?
  requiredDocs   String[]
  submittedAt    DateTime?
  approvedAt     DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deadline       DateTime?
  missingDocs    String?
  referenceNo    String?
  trackingId     String?           @unique
  vendorCost     Float?            @default(0)
  vendorId       String?
  tasks          Json?
  isKioskRequest Boolean           @default(false)
  tokenNumber    Int?
  callbackAt     DateTime?
  comments       Json?
  serviceDocUrls String[]
  tags           String[]
  amountPaid     Float             @default(0)
  feedback       String?
  rating         Int?
  payments       CustomerPayment[]
  assignedTo     User?             @relation(fields: [assignedToId], references: [id])
  customer       Customer          @relation(fields: [customerId], references: [id])
  vendor         Vendor?           @relation(fields: [vendorId], references: [id])

  @@index([trackingId])
  @@index([serviceType])
  @@index([status])
  @@index([paymentStatus])
  @@index([customerId])
  @@index([createdAt])
}

model Invoice {
  id            String            @id @default(cuid())
  invoiceNumber String            @unique
  customerId    String
  createdById   String
  subtotal      Float
  discount      Float             @default(0)
  gst           Float             @default(0)
  total         Float
  paymentMode   PaymentMode       @default(CASH)
  paymentStatus PaymentStatus     @default(UNPAID)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  amountPaid    Float             @default(0)
  dueDate       DateTime?
  type          String            @default("INVOICE")
  payments      CustomerPayment[]
  createdBy     User              @relation(fields: [createdById], references: [id])
  customer      Customer          @relation(fields: [customerId], references: [id])
  items         InvoiceItem[]

  @@index([customerId])
  @@index([paymentStatus])
  @@index([paymentMode])
  @@index([createdAt])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  name      String
  quantity  Int
  price     Float
  total     Float
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([name])
}

model Book {
  id            String     @id @default(cuid())
  name          String
  author        String?
  category      String?
  isbn          String?
  purchasePrice Float
  sellingPrice  Float
  quantity      Int        @default(0)
  minStock      Int        @default(5)
  barcode       String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sales         BookSale[]

  @@index([name])
  @@index([category])
  @@index([isbn])
  @@index([barcode])
  @@index([updatedAt])
}

model BookSale {
  id        String   @id @default(cuid())
  bookId    String
  quantity  Int
  price     Float
  total     Float
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id])

  @@index([bookId])
  @@index([createdAt])
}

model InventoryItem {
  id            String                 @id @default(cuid())
  name          String
  category      String
  purchasePrice Float
  sellingPrice  Float
  quantity      Int                    @default(0)
  minStock      Int                    @default(5)
  unit          String                 @default("piece")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  requiredDocs  String[]               @default([])
  transactions  InventoryTransaction[]

  @@index([name])
  @@index([category])
  @@index([updatedAt])
}

model InventoryTransaction {
  id        String        @id @default(cuid())
  itemId    String
  type      String
  quantity  Int
  price     Float
  notes     String?
  createdAt DateTime      @default(now())
  item      InventoryItem @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([type])
  @@index([createdAt])
}

model Document {
  id         String    @id @default(cuid())
  customerId String
  name       String
  url        String
  type       String
  createdAt  DateTime  @default(now())
  expiryDate DateTime?
  customer   Customer  @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([type])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String?
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model ShopSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  amount      Float
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([date])
}

model Income {
  id          String   @id @default(cuid())
  category    String
  amount      Float
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([date])
}

model Vendor {
  id           String              @id @default(cuid())
  name         String
  phone        String?
  company      String?
  balance      Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  services     Service[]
  transactions VendorTransaction[]
}

model VendorTransaction {
  id          String   @id @default(cuid())
  vendorId    String
  type        String
  amount      Float
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  vendor      Vendor   @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([type])
  @@index([date])
}

model OnlineServiceCategory {
  id          String              @id @default(cuid())
  title       String
  description String?
  tag         String?
  icon        String?
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  links       OnlineServiceLink[]

  @@index([order])
}

model OnlineServiceLink {
  id         String                @id @default(cuid())
  categoryId String
  title      String
  href       String
  order      Int                   @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  category   OnlineServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([order])
}

model AccountBalance {
  id        String   @id @default(cuid())
  date      DateTime @unique
  opening   Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model FileDrop {
  id           String   @id @default(cuid())
  filename     String
  url          String
  size         Int
  type         String   @default("unknown")
  createdAt    DateTime @default(now())
  customerName String?
  direction    String   @default("MOBILE_TO_PC")
  mobileNumber String?
}

model CustomerPayment {
  id          String      @id @default(cuid())
  customerId  String
  serviceId   String?
  invoiceId   String?
  amount      Float
  paymentMode PaymentMode @default(CASH)
  referenceNo String?
  notes       String?
  date        DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice     Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service     Service?    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([serviceId])
  @@index([invoiceId])
  @@index([date])
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum ServiceStatus {
  PENDING
  SUBMITTED
  PROCESSING
  APPROVED
  DELIVERED
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  PENDING
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}
